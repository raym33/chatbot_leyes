# Copy to .env to override defaults (optional). All run locally.
# Chat model (Ollama tag). Smaller = faster on CPU; bigger = better answers.
#   light/CPU:  llama3.2:3b   ·   balanced: qwen2.5:7b-instruct   ·   best: qwen2.5:14b-instruct
CHAT_MODEL=qwen2.5:7b-instruct

# Embedding model (multilingual recommended for Spanish legal text).
EMBED_MODEL=bge-m3

# 0 = starter set (main codes, fast). 1 = ALL state laws (~4000, hours on first boot).
INGEST_ALL=0
